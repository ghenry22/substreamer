{
  "name": "substreamer",
  "version": "8.1.9",
  "license": "GPL-3.0-or-later",
  "main": "./index.js",
  "scripts": {
    "start": "expo start",
    "android": "source scripts/env-android.sh && expo run:android ${EXPO_ANDROID_DEVICE:+--device $EXPO_ANDROID_DEVICE}",
    "android:device": "source scripts/env-android.sh && expo run:android",
    "ios": "expo run:ios",
    "concurrent": "npx concurrently \"npm run ios\" \"npm run android\"",
    "prebuild": "expo prebuild --clean",
    "web": "expo start --web",
    "test": "jest",
    "validate:i18n": "node scripts/validate-translations.js",
    "validate:proguard": "node scripts/validate-proguard-rules.js",
    "validate:modules": "node scripts/validate-module-inventory.js",
    "test:watch": "jest --watchAll",
    "test:modules": "scripts/test-modules.sh",
    "build:modules": "scripts/build-modules.sh",
    "clean:rnqp": "rm -rf node_modules/react-native-queue-player/android/.cxx node_modules/react-native-queue-player/android/build",
    "test:coverage": "jest --coverage --coverageReporters=text --coverageReporters=html",
    "generate-assets": "node scripts/generate-assets.js",
    "release": "node scripts/create-release.js",
    "release:patch": "node scripts/create-release.js patch",
    "release:minor": "node scripts/create-release.js minor",
    "release:major": "node scripts/create-release.js major",
    "reset-changelog": "node scripts/reset-store-changelog.js",
    "terminal-log": "script -a /tmp/claude-terminal.txt",
    "rebase": "git fetch origin && git rebase origin/master",
    "postinstall": "patch-package",
    "local-ci": "node scripts/local-ci.js"
  },
  "dependencies": {
    "@formatjs/intl-datetimeformat": "^7.8.2",
    "@formatjs/intl-getcanonicallocales": "^3.2.12",
    "@formatjs/intl-locale": "^5.3.12",
    "@formatjs/intl-numberformat": "^9.4.3",
    "@formatjs/intl-pluralrules": "^6.3.16",
    "@op-engineering/op-sqlite": "^18.2.5",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-community/slider": "5.2.2",
    "@react-native-vector-icons/fontawesome5": "^14.0.0",
    "@react-native-vector-icons/ionicons": "^14.0.0",
    "@react-native-vector-icons/material-design-icons": "^14.0.0",
    "@shopify/flash-list": "^2.3.3",
    "double-metaphone": "^2.0.1",
    "drizzle-orm": "^0.45.4",
    "expo": "~58.0.20",
    "expo-async-fs": "file:./modules/expo-async-fs",
    "expo-backup-exclusions": "file:./modules/expo-backup-exclusions",
    "expo-battery": "~58.0.3",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.11",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.12",
    "expo-font": "~58.0.9",
    "expo-gzip": "file:./modules/expo-gzip",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-image-colors": "file:./modules/expo-image-colors",
    "expo-image-resize": "file:./modules/expo-image-resize",
    "expo-intent-launcher": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.19",
    "expo-move-to-back": "file:./modules/expo-move-to-back",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.27",
    "expo-screen-orientation": "~58.0.3",
    "expo-scroll-to-top": "file:./modules/expo-scroll-to-top",
    "expo-sharing": "~58.0.20",
    "expo-ssl-trust": "file:./modules/expo-ssl-trust",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "fastest-levenshtein": "^1.0.16",
    "i18next": "^26.5.7",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^13.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.5",
    "react-native": "0.88.0",
    "react-native-bootsplash": "^7.3.4",
    "react-native-gesture-handler": "~3.4.0",
    "react-native-keyboard-controller": "1.22.8",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-queue-player": "3.0.0",
    "react-native-reanimated": "4.7.1",
    "react-native-reorderable-list": "^0.18.2",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "subsonic-api": "file:./modules/subsonic-api",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.11",
    "expo-dev-client": "~58.0.16",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.3.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "@react-native-community/slider",
        "@shopify/flash-list",
        "react-native-bootsplash",
        "react-native-gesture-handler",
        "react-native-keyboard-controller"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@op-engineering/op-sqlite",
          "expo-async-fs",
          "expo-backup-exclusions",
          "expo-gzip",
          "expo-image-colors",
          "expo-image-resize",
          "expo-move-to-back",
          "expo-scroll-to-top",
          "expo-ssl-trust",
          "react-native-nitro-modules",
          "react-native-queue-player",
          "subsonic-api"
        ]
      }
    }
  }
}
