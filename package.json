{
  "name": "substreamer",
  "version": "8.0.91",
  "license": "GPL-3.0-or-later",
  "main": "./index.js",
  "scripts": {
    "start": "expo start",
    "android": "source scripts/env-android.sh && expo run:android ${EXPO_ANDROID_DEVICE:+--device $EXPO_ANDROID_DEVICE}",
    "android:device": "source scripts/env-android.sh && expo run:android",
    "ios": "expo run:ios",
    "concurrent": "npx concurrently \"npm run ios\" \"npm run android\"",
    "prebuild": "expo prebuild --clean",
    "web": "expo start --web",
    "test": "jest",
    "validate:i18n": "node scripts/validate-translations.js",
    "validate:proguard": "node scripts/validate-proguard-rules.js",
    "validate:modules": "node scripts/validate-module-inventory.js",
    "test:watch": "jest --watchAll",
    "test:modules": "scripts/test-modules.sh",
    "test:ios-large-queue": "scripts/verify-ios-large-queue-performance.sh",
    "build:modules": "scripts/build-modules.sh",
    "clean:rnqp": "rm -rf node_modules/react-native-queue-player/android/.cxx node_modules/react-native-queue-player/android/build",
    "test:coverage": "jest --coverage --coverageReporters=text --coverageReporters=html",
    "generate-assets": "node scripts/generate-assets.js",
    "release": "node scripts/create-release.js",
    "release:patch": "node scripts/create-release.js patch",
    "release:minor": "node scripts/create-release.js minor",
    "release:major": "node scripts/create-release.js major",
    "reset-changelog": "node scripts/reset-store-changelog.js",
    "terminal-log": "script -a /tmp/claude-terminal.txt",
    "rebase": "git fetch origin && git rebase origin/master",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@formatjs/intl-datetimeformat": "^7.4.9",
    "@formatjs/intl-getcanonicallocales": "^3.2.10",
    "@formatjs/intl-locale": "^5.3.9",
    "@formatjs/intl-numberformat": "^9.3.11",
    "@formatjs/intl-pluralrules": "^6.3.10",
    "@op-engineering/op-sqlite": "^17.1.2",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-community/slider": "^5.2.0",
    "@react-native-vector-icons/fontawesome5": "^13.1.2",
    "@react-native-vector-icons/ionicons": "^13.1.2",
    "@react-native-vector-icons/material-design-icons": "^13.1.2",
    "@shopify/flash-list": "^2.3.2",
    "double-metaphone": "^2.0.1",
    "drizzle-orm": "^0.45.2",
    "expo": "~57.0.8",
    "expo-async-fs": "file:./modules/expo-async-fs",
    "expo-backup-exclusions": "file:./modules/expo-backup-exclusions",
    "expo-battery": "~57.0.1",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.7",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.3",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-gzip": "file:./modules/expo-gzip",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-colors": "file:./modules/expo-image-colors",
    "expo-image-resize": "file:./modules/expo-image-resize",
    "expo-intent-launcher": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-localization": "~57.0.1",
    "expo-location": "~57.0.6",
    "expo-move-to-back": "file:./modules/expo-move-to-back",
    "expo-notifications": "~57.0.7",
    "expo-router": "~57.0.8",
    "expo-screen-orientation": "~57.0.1",
    "expo-scroll-to-top": "file:./modules/expo-scroll-to-top",
    "expo-sharing": "~57.0.7",
    "expo-ssl-trust": "file:./modules/expo-ssl-trust",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "fastest-levenshtein": "^1.0.16",
    "i18next": "^26.3.2",
    "node-addon-api": "^8.7.0",
    "node-gyp": "^13.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.8",
    "react-native": "0.86.0",
    "react-native-bootsplash": "^7.3.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.22.2",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-queue-player": "1.1.1",
    "react-native-reanimated": "4.5.1",
    "react-native-reorderable-list": "^0.18.0",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.5",
    "react-native-worklets": "0.10.2",
    "subsonic-api": "file:./modules/subsonic-api",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.85.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "~29.5.14",
    "@types/react": "^19.2.15",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "better-sqlite3": "^13.0.1",
    "drizzle-kit": "^0.31.10",
    "expo-dev-client": "~57.0.9",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.2",
    "patch-package": "^8.0.1",
    "sharp": "^0.35.3",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "@shopify/flash-list",
        "react-native-bootsplash",
        "react-native-safe-area-context",
        "react-native-svg",
        "react-native-reanimated",
        "react-native-worklets",
        "react-native-keyboard-controller"
      ]
    },
    "doctor": {
      "dependencies": {
        "exclude": [
          "react-native-safe-area-context"
        ]
      },
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@op-engineering/op-sqlite",
          "expo-async-fs",
          "expo-backup-exclusions",
          "expo-gzip",
          "expo-image-colors",
          "expo-image-resize",
          "expo-move-to-back",
          "expo-scroll-to-top",
          "expo-ssl-trust",
          "react-native-nitro-modules",
          "react-native-queue-player",
          "subsonic-api"
        ]
      }
    }
  }
}
